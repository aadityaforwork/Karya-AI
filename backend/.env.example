# Copy to .env and fill in. Karya runs without a key using the deterministic mock engine.
OPENAI_API_KEY=

# Tier -> model mapping. Tier 0 runs first (cheap), escalates to 1 then 2.
KARYA_TIER0_MODEL=gpt-4o-mini
KARYA_TIER1_MODEL=gpt-4o
KARYA_TIER2_MODEL=gpt-4o

# Confidence gate. A tier's answer is accepted when confidence >= this, else escalate.
KARYA_GATE_TAU=0.72

# Force the deterministic mock engine even when a key is present (great for demos/tests).
KARYA_FORCE_MOCK=false
